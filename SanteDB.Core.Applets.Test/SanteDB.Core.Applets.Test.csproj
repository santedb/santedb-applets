<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net48</TargetFrameworks>
		<IsPackable>false</IsPackable>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(VersionNumber)' == ''">
		<VersionNumber>3.1-debug</VersionNumber>
	</PropertyGroup>

	<Choose>
		<When Condition="$(SolutionName.Contains('-nuget'))">
			<ItemGroup>
				<PackageReference Include="SanteDB.Core.Api" Version="$(VersionNumber)" />
				<PackageReference Include="SanteDB.Core.Model" Version="$(VersionNumber)" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<ProjectReference Include="..\..\santedb-model\SanteDB.Core.Model\SanteDB.Core.Model.csproj">
				</ProjectReference>
				<ProjectReference Include="..\..\santedb-api\SanteDB.Core.Api\SanteDB.Core.Api.csproj">
				</ProjectReference>
			</ItemGroup>
		</Otherwise>
	</Choose>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="[13.0.4,13.1)" />
		<PackageReference Include="NUnit" Version="[4.5.0,5)" />
		<PackageReference Include="NUnit3TestAdapter" Version="[6.1.0,7)" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.3.0,18.4)" />
		<PackageReference Include="SharpCompress" Version="0.40.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SanteDB.Core.Applets\SanteDB.Core.Applets.csproj">
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\SanteDB.licenseheader">
			<Link>SanteDB.licenseheader</Link>
		</None>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="*.xml" />
		<EmbeddedResource Include="*.json" />
	</ItemGroup>

</Project>